{
  "name": "swapi-integration",
  "version": "1.1.0",
  "description": "A project to integrate with StarWars API and DynamoDB on AWS using AWS SAM and Typescript",
  "engines": {
    "node": ">=24.17.0",
    "npm": ">=10.2.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "biome:check": "biome check",
    "biome:check:fix": "biome check --write",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "secrets:scan": "betterleaks git --verbose",
    "secrets:protect": "betterleaks git --staged --verbose",
    "dynamodb-local:start": "docker-compose -f docker/docker-compose-dynamodb.yaml up -d",
    "dynamodb-local:stop": "docker-compose -f docker/docker-compose-dynamodb.yaml down",
    "build": "sam build",
    "start:local": "sam local start-api",
    "deploy:guided": "sam deploy --guided",
    "prepare": "husky"
  },
  "keywords": [
    "Clean Architecture",
    "Node",
    "Typescript",
    "AWS",
    "Husky",
    "BetterLeaks",
    "Biome",
    "Vitest"
  ],
  "author": "Jorge Bizarro <jorgeluisbizarroreyes@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.462.0",
    "@aws-sdk/lib-dynamodb": "^3.464.0",
    "@aws-sdk/util-dynamodb": "^3.462.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@types/aws-lambda": "^8.10.130",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.9"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  }
}